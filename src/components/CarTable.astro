---
// Supported cars as a capability matrix, synced from the wiki's
// supported-cars.md. The sync script (scripts/sync-wiki.mjs) owns the
// data; this component only renders the flags and carries the footnote.
// Cell vocabulary: ✓ (native), ✓ with swap, — (not available), ? (built
// to work, not yet validated on that platform).
interface CapRow {
  car: string;
  model: string;
  year: string;
  stz: boolean | "with swap";
  alphaLong: boolean | "with swap" | "unknown";
}
interface Props {
  cars: CapRow[];
}
const { cars } = Astro.props;

const capClass = (v: boolean | "with swap" | "unknown") =>
  v === true
    ? "cap-yes"
    : v === "with swap"
      ? "cap-swap"
      : v === "unknown"
        ? "cap-unknown"
        : "cap-no";
const capText = (v: boolean | "with swap" | "unknown") =>
  v === true ? "✓" : v === "unknown" ? "?" : "—";

/* the model cell shows only on the first row of each model group, so
 * the families read grouped like they do on the wiki */
let lastModel = "";
---

<div class="table-scroll">
  <table class="cartable captable">
    <thead>
      <tr>
        <th scope="col">model</th>
        <th scope="col">year</th>
        <th scope="col">steer-to-zero</th>
        <th scope="col">alpha longitudinal</th>
      </tr>
    </thead>
    <tbody>
      {
        cars.map((c) => {
          const showModel = c.model !== lastModel;
          lastModel = c.model;
          return (
            <tr>
              <th scope="row">{showModel ? c.model : ""}</th>
              <td>{c.year}</td>
              <td class={capClass(c.stz)}>
                {c.stz === "with swap"
                  ? (<>✓ <small>with swap</small></>)
                  : capText(c.stz)}
              </td>
              <td class={capClass(c.alphaLong)}>
                {c.alphaLong === "with swap"
                  ? (<>✓ <small>with swap</small></>)
                  : capText(c.alphaLong)}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
<p class="cap-note">
  Radar and AEB are off while alpha longitudinal is on. The pre-2021 CX-9
  keeps it off even with the swap: its radar does not publish the track
  frames the port stands in for. A ? marks what the port is built to grant
  but has not been validated on that platform yet — the Mazda 3 and Mazda 6
  are community-reported only, with fewer test miles than the CX-5 and CX-9.
</p>
