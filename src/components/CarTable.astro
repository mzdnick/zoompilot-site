---
// Supported cars as a capability matrix, synced from the wiki's
// supported-cars.md. The sync script (scripts/sync-wiki.mjs) owns the
// data; this component only renders the flags and carries the footnote.
// Cell vocabulary: ✓ (native), with swap, — (not available), ? (built
// to work, not yet validated on that platform).
interface CapRow {
  car: string;
  model: string;
  year: string;
  stz: boolean | "with swap";
  alphaLong: boolean | "with swap" | "unknown";
}
interface Props {
  cars: CapRow[];
  note: string;
}
const { cars, note } = Astro.props;

const capClass = (v: boolean | "with swap" | "unknown") =>
  v === true
    ? "cap-yes"
    : v === "with swap"
      ? "cap-swap"
      : v === "unknown"
        ? "cap-unknown"
        : "cap-no";
const capText = (v: boolean | "with swap" | "unknown") =>
  v === true ? "✓" : v === "with swap" ? "with swap" : v === "unknown" ? "?" : "—";

/* the model cell shows only on the first row of each model group, so
 * the families read grouped like they do on the wiki */
let lastModel = "";
---

<div class="table-scroll">
  <table class="cartable captable">
    <thead>
      <tr>
        <th scope="col">model</th>
        <th scope="col">year</th>
        <th scope="col">steer-to-zero</th>
        <th scope="col">alpha longitudinal</th>
      </tr>
    </thead>
    <tbody>
      {
        cars.map((c) => {
          const showModel = c.model !== lastModel;
          lastModel = c.model;
          return (
            <tr>
              <th scope="row">{showModel ? c.model : ""}</th>
              <td>{c.year}</td>
              <td class={capClass(c.stz)}>{capText(c.stz)}</td>
              <td class={capClass(c.alphaLong)}>{capText(c.alphaLong)}</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
<p class="cap-note">{note}</p>
