---
// Supported cars as a capability matrix, synced from the wiki's
// supported-cars.md. The sync script (scripts/sync-wiki.mjs) owns the
// data; this component only renders the flags and carries the footnote.
interface CapRow {
  car: string;
  model: string;
  year: string;
  stzNative: boolean | "n/a";
  stzSwap: boolean | "n/a";
  alphaLong: boolean;
  torque: "native" | "with swap";
}
interface Props {
  cars: CapRow[];
}
const { cars } = Astro.props;

const mark = (v: boolean | "n/a") =>
  v === true ? "✓" : v === "n/a" ? "n/a" : "—";
const capClass = (v: boolean | "n/a") =>
  v === true ? "cap-yes" : v === "n/a" ? "cap-na" : "cap-no";

/* the model cell shows only on the first row of each model group, so
 * the families read grouped like they do on the wiki */
let lastModel = "";
---

<div class="table-scroll">
  <table class="cartable captable">
    <thead>
      <tr>
        <th scope="col">model</th>
        <th scope="col">year</th>
        <th scope="col">native steer-to-zero</th>
        <th scope="col">steer-to-zero with swap</th>
        <th scope="col">alpha longitudinal</th>
        <th scope="col">pre-seeded torque</th>
      </tr>
    </thead>
    <tbody>
      {
        cars.map((c) => {
          const showModel = c.model !== lastModel;
          lastModel = c.model;
          return (
            <tr>
              <th scope="row">{showModel ? c.model : ""}</th>
              <td>{c.year}</td>
              <td class={capClass(c.stzNative)}>{mark(c.stzNative)}</td>
              <td class={capClass(c.stzSwap)}>{mark(c.stzSwap)}</td>
              <td class={capClass(c.alphaLong)}>{mark(c.alphaLong)}</td>
              <td class={c.torque === "native" ? "cap-yes" : "cap-swap"}>
                {c.torque === "native" ? (
                  "✓"
                ) : (
                  <>
                    ✓ <small>with swap</small>
                  </>
                )}
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
<p class="cap-note">
  Radar and AEB are off while alpha longitudinal is on. The pre-2021 CX-9
  keeps it off even with the swap: its radar does not publish the track
  frames the port stands in for. The Mazda 3 and Mazda 6 rows are
  community-reported, with fewer test miles than the CX-5 and CX-9.
</p>
