---
// Spec strip: the plain-English claims, one glance under the hero.
// Benefits lead; the measured figures stay in the notes and still trace
// to the wiki's measurement record. (12/frame vs stock 10 and the seven
// bands: features/steering; 0 mph: features/steering#steering-to-zero;
// the swap claim: getting-started/supported-cars.)
const stats = [
  { big: "any Mazda", unit: "in the support list", note: "runs on six platforms — a 2022-25 CX-5 EPS, factory-fitted or swapped, adds steer-to-zero automatically" },
  { big: "faster", unit: "steering response", note: "commands the motor's full 12 units per frame — stock openpilot stops at 10" },
  { big: "tuned", unit: "for every speed", note: "seven learned speed ranges keep the assist right, city street to highway" },
  { big: "0", unit: "mph floor", note: "steering assist holds to a standstill" },
];
---

<dl class="specstrip" aria-label="zoompilot at a glance">
  {
    stats.map((s) => (
      <div>
        <dt>
          <span class="big">{s.big}</span>
          <span class="unit">{s.unit}</span>
        </dt>
        <dd>{s.note}</dd>
      </div>
    ))
  }
</dl>
