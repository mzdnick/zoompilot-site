---
// The EPS authority chart, section 01: how much steering torque the
// EPS can actually apply at each speed, and how much of it each
// controller will ask for. All geometry lives in
// src/data/chart-geometry.js, shared with the wiki's copy of this
// chart (scripts/gen-wiki-chart.mjs) so the two can never drift apart.
import {
  X0,
  X1,
  Y0,
  Y1,
  VIEW_W,
  VIEW_H,
  x,
  y,
  zpPath,
  zpSharedPath,
  stockPath,
  gapPath,
  GAP_V,
  GAP_PCT,
  xTicks,
  yTicks,
} from "../data/chart-geometry.js";
import { repo } from "../data/changelog.js";

const wikiUrl = `${repo.wiki}/technical/lateral-tune/`;
const gapLabelY = y(980);
---

<figure class="tchart">
  <div class="tchart-frame">
    <svg
      viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
      role="img"
      aria-label="Available steering torque from the EPS across speed, up to 40 mph. The EPS can apply up to 1148 counts at neighborhood speeds, ramping down through nine measured points to 620 by about 32 mph. zoompilot tracks that measured ceiling, so its line is the ceiling: up to 44 percent more torque than stock, with no hardware mods. Stock openpilot caps every command at one flat 800-count scale; past about 29 mph the EPS clamps both to the same torque, drawn as one line the two share."
    >
      <!-- y grid -->
      {
        yTicks.map((c) => (
          <g>
            <line class="tc-grid" x1={X0} x2={X1} y1={y(c)} y2={y(c)} />
            <text class="tc-text" x={X0 - 8} y={y(c) + 4} text-anchor="end">
              {c}
            </text>
          </g>
        ))
      }
      <!-- the torque stock strands, shaded from the axis to the join -->
      <path class="tc-gap-fill" d={gapPath} />
      <text class="tc-zp-label" x={x(GAP_V) + 8} y={gapLabelY}>
        <tspan class="tc-gap-note" x={x(GAP_V) + 8} dy="0">up to</tspan>
        <tspan x={x(GAP_V) + 8} dy="13">{GAP_PCT}% more torque</tspan>
        <tspan class="tc-gap-tag" x={x(GAP_V) + 8} dy="13">
          with no hardware mods
        </tspan>
      </text>
      <!-- stock: one flat cap, then EPS-limited like everyone -->
      <path id="tc-stock" class="tc-stock" d={stockPath} />
      <text class="tc-stock-label" x={X0 + 8} y={y(800) + 16} text-anchor="start">
        stock openpilot
      </text>
      <!-- zoompilot: the full measured ceiling -->
      <path id="tc-zp" class="tc-zp" d={zpPath} />
      <!-- the stretch both controllers share, dashed over stock -->
      <path id="tc-zp-shared" class="tc-zp-shared" d={zpSharedPath} />
      <text class="tc-zp-label" x={X0 + 8} y={y(1148) - 8} text-anchor="start">
        zoompilot
      </text>
      <!-- axes -->
      <line class="tc-axis" x1={X0} x2={X1} y1={Y1} y2={Y1} />
      <line class="tc-axis" x1={X0} x2={X0} y1={Y0} y2={Y1} />
      <!-- x labels -->
      {
        xTicks.map((t) => (
          <g>
            <line
              class="tc-axis"
              x1={x(t.v)}
              x2={x(t.v)}
              y1={Y1}
              y2={Y1 + 4}
            />
            <text class="tc-text" x={x(t.v)} y={Y1 + 18} text-anchor="middle">
              {t.mph}
            </text>
          </g>
        ))
      }
      <text class="tc-text tc-axis-title" x={X1} y={Y1 + 31} text-anchor="end">
        speed · mph
      </text>
      <text class="tc-text tc-axis-title" x={X0} y={11} text-anchor="start">
        torque · counts
      </text>
    </svg>
  </div>
  <figcaption class="tchart-cap">
    How much steering torque your car's electric power steering can
    apply, at each speed. The motor is strongest at low speeds, and
    its strength falls as you go faster. Stock openpilot caps it at
    one fixed value — the flat line at 800 on the chart. That cap
    sits well below the motor's real low-speed strength: strength
    the car already has. zoompilot lets the steering use the motor's
    full measured strength — up to 44% more steering torque than
    stock, with no hardware mods. The shaded band between the two
    lines is that gain. It shrinks as you speed up and is gone past
    about 29 mph. Past that point both systems reach the car's own
    limit; the dashed stretch is the line they share. The ceiling
    and the cap are measured. Source: the{" "}
    <a href={wikiUrl}>lateral tune measurement record</a>.
  </figcaption>
</figure>

<script>
  /* draw both lines in when the chart first scrolls into view */
  const frame = document.querySelector(".tchart-frame");
  if (
    frame &&
    "IntersectionObserver" in window &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          frame.classList.add("drawn");
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(frame);
  } else {
    frame?.classList.add("drawn");
  }
</script>
