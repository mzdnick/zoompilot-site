---
// The EPS behavior chart, section 01: old vs new steering response
// across the full speed range. X = speed, Y = EPS torque (CAN counts).
// All geometry lives in src/data/chart-geometry.js, shared with the
// wiki's copy of this chart (scripts/gen-wiki-chart.mjs) so the two
// can never drift apart.
import {
  X0,
  X1,
  Y0,
  Y1,
  VIEW_W,
  VIEW_H,
  CLIFF_MID,
  x,
  y,
  shownBands,
  zpPath,
  stockPath,
  ceilingPath,
  scalePath,
  xTicks,
  yTicks,
} from "../data/chart-geometry.js";
import { repo } from "../data/changelog.js";

const wikiUrl = `${repo.wiki}/technical/lateral-tune/`;
---

<figure class="tchart">
  <div class="tchart-frame">
    <svg
      viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
      role="img"
      aria-label="Steering torque across speed, one held corner demand, up to about 45 mph. Measured curves: the EPS torque ceiling, near 1148 counts at neighborhood speeds and ramping down nine measured points to 620 by the cliff at about 32 mph; the STEER_MAX CAN scale, 1200 counts stepping to 800 across the cliff window — a unit conversion and PID limit, not a torque step. zoompilot's line comes from the learned per-band gain and friction: it rises through neighborhood speeds, stays continuous through the cliff window, and settles onto stock's level past about 37 mph. Stock openpilot applies one factor at every speed: a flat line."
    >
      <!-- y grid -->
      {
        yTicks.map((c) => (
          <g>
            <line class="tc-grid" x1={X0} x2={X1} y1={y(c)} y2={y(c)} />
            <text class="tc-text" x={X0 - 8} y={y(c) + 4} text-anchor="end">
              {c}
            </text>
          </g>
        ))
      }
      <!-- band hairlines: the real bin boundaries inside the window -->
      {
        shownBands.map((b) => (
          <line
            class="tc-band"
            x1={x(b.ms)}
            x2={x(b.ms)}
            y1={Y1}
            y2={Y0 + 6}
          />
        ))
      }
      <!-- the measured cliff -->
      <line
        class="tc-cliff"
        x1={x(CLIFF_MID)}
        x2={x(CLIFF_MID)}
        y1={Y1}
        y2={Y0}
      />
      <text class="tc-cliff-label" x={x(CLIFF_MID) + 8} y={Y0 + 10}>
        the cliff · ~32 mph
      </text>
      <!-- the CAN scale: unit conversion and PID limits, not torque -->
      <path id="tc-scale" class="tc-scale" d={scalePath} />
      <text class="tc-text" x={X0 + 8} y={y(1200) - 8} text-anchor="start">
        STEER_MAX · CAN scale · conversion + PID limits
      </text>
      <!-- measured: the EPS's own applied-torque ceiling -->
      <path id="tc-ceiling" class="tc-ceiling" d={ceilingPath} />
      <text class="tc-text" x={X1 - 4} y={y(620) - 10} text-anchor="end">
        EPS ceiling · measured
      </text>
      <!-- old behavior: one factor for every speed -->
      <path id="tc-stock" class="tc-stock" d={stockPath} />
      <text class="tc-stock-label" x={X1 - 4} y={y(560) + 16} text-anchor="end">
        stock openpilot · one factor, all speeds
      </text>
      <!-- new behavior: the learned tables, one held demand -->
      <path id="tc-zp" class="tc-zp" d={zpPath} />
      <text class="tc-zp-label" x={x(0.6)} y={y(900) - 22}>
        zoompilot · learned per-band torque
      </text>
      <!-- axes -->
      <line class="tc-axis" x1={X0} x2={X1} y1={Y1} y2={Y1} />
      <line class="tc-axis" x1={X0} x2={X0} y1={Y0} y2={Y1} />
      <!-- x labels -->
      {
        xTicks.map((t) => (
          <g>
            <line
              class="tc-axis"
              x1={x(t.v)}
              x2={x(t.v)}
              y1={Y1}
              y2={Y1 + 4}
            />
            <text class="tc-text" x={x(t.v)} y={Y1 + 18} text-anchor="middle">
              {t.mph}
            </text>
          </g>
        ))
      }
      <text class="tc-text tc-axis-title" x={X1} y={Y1 + 31} text-anchor="end">
        speed · mph
      </text>
      <text
        class="tc-text tc-axis-title"
        transform={`translate(14 ${Y1 - 6}) rotate(-90)`}
        text-anchor="start"
      >
        EPS torque · CAN counts
      </text>
    </svg>
  </div>
  <figcaption class="tchart-cap">
    One corner demand, held constant. The counts it needs come from the
    EPS's own learned tables — gain and friction per speed band,
    interpolated in count space, so the applied torque stays continuous
    through the cliff: the STEER_MAX step changes the CAN scale and the
    PID limits, not the torque. Stock openpilot carries one factor and
    one flat 800-count scale — blind to both the ceiling and the scale.
    The ceiling, the scale step, and the band boundaries are measured;
    the demand level is illustrative. Source: the
    <a href={wikiUrl}>lateral tune measurement record</a>.
  </figcaption>
</figure>

<script>
  /* draw both response lines in when the chart first scrolls into view */
  const frame = document.querySelector(".tchart-frame");
  if (
    frame &&
    "IntersectionObserver" in window &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          frame.classList.add("drawn");
          io.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    io.observe(frame);
  } else {
    frame?.classList.add("drawn");
  }
</script>
