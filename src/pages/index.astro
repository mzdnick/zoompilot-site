---
// zoompilot.ai — single page, spec-sheet order. Sections jump from the
// index grid under the hero; the top bar scroll-spies features, setup,
// install, and changelog.
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Hero from "../components/Hero.astro";
import SpecStrip from "../components/SpecStrip.astro";
import SectionIndex from "../components/SectionIndex.astro";
import Section from "../components/Section.astro";
import Ledger from "../components/Ledger.astro";
import TorqueChart from "../components/TorqueChart.astro";
import CarTable from "../components/CarTable.astro";
import CarChecker from "../components/CarChecker.astro";
import Compare from "../components/Compare.astro";
import FAQ from "../components/FAQ.astro";
import SetupDemo from "../components/SetupDemo.astro";
import InstallCard from "../components/InstallCard.astro";
import FirstDrive from "../components/FirstDrive.astro";
import Changelog from "../components/Changelog.astro";
import Footer from "../components/Footer.astro";
import { installUrl, repo } from "../data/changelog.js";
import cars from "../data/supported-cars.json";

const index = [
  { id: "features", n: "01", t: "steering improvements" },
  { id: "cruise", n: "02", t: "radar cruise enhancements" },
  { id: "alerts", n: "03", t: "fix annoyances" },
  { id: "sensors", n: "04", t: "wire up sensors" },
  { id: "alpha-long", n: "05", t: "alpha longitudinal" },
  { id: "coverage", n: "06", t: "additional Mazdas" },
  { id: "compare", n: "07", t: "how it compares" },
  { id: "faq", n: "08", t: "questions" },
  { id: "setup", n: "09", t: "recommended setup" },
  { id: "install", n: "10", t: "install" },
  { id: "first-drive", n: "11", t: "first drive" },
  { id: "log", n: "12", t: "changelog" },
];

/* SoftwareApplication structured data for search engines */
const appLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "zoompilot",
  applicationCategory: "Driver assistance software",
  operatingSystem: "comma 3X, comma 3",
  description:
    "An openpilot fork that steers to zero on any Mazda with a 2022-25 CX-5 electric power steering — factory-fitted or swapped in, detected automatically — and runs on every supported Mazda platform, tuned to measured steering limits instead of another car's spec sheet.",
  isAccessibleForFree: true,
  url: Astro.site,
  sameAs: [repo.github, repo.wiki],
};
---

<Base
  title="zoompilot: a Mazda-optimized fork of sunnypilot"
  description="An openpilot fork that steers to zero on any Mazda with a 2022-25 CX-5 electric power steering — factory-fitted or swapped in, detected automatically — and runs on every supported Mazda platform, tuned to measured steering limits instead of another car's spec sheet."
>
  <TopBar />

  <main id="main">
    <Hero />

    <SpecStrip />

    <SectionIndex entries={index} />

    <!-- ============ steering ============ -->
    <section id="features" aria-labelledby="h-steering">
      <Section
        idx="01"
        id="h-steering"
        title="steering improvements"
        intro="The 2022-25 CX-5 electronic power steering (EPS) motor has been reverse-engineered, so that zoompilot can make use of its full range of available torque."
      />
      <Ledger
        items={[
          {
            dt: "EPS-swaps supported",
            dd: "An EPS from a 2022-25 CX-5 allows steer-to-zero capabilities. zoompilot recognizes the EPS — factory or swapped — and automatically adapts.",
          },
          {
            dt: "Speed-dependent torque",
            dd: "The Mazda EPS allow for greater steering torque at lower speeds. zoompilot uses the full range of torque available to the EPS, enabling up to 44% more torque over stock openpilot.",
          },
          //similar to above
          //{
            //dt: "Tuned for every speed",
            //dd: "One setting for all speeds is wrong at most of them. zoompilot learns seven speed ranges, each with its own steering factor and friction.",
          //},
          {
            dt: "Faster torque ramping",
            dd: "zoompilot commands up to 12 torque units per frame, compared with stock openpilot’s 10, allowing the EPS to reach the requested torque faster.",
          },
          {
            dt: "Factory-matched specs",
            dd: "Stock openpilot uses unoptimized values for Mazda platforms. zoompilot sets steering ratio, mass, wheelbase, and lag to Mazda&rsquo;s real figures, then refines them against thousands of miles of driving data.",
          },
        ]}
      />
      <TorqueChart />
      <p class="wiki-more">
        The measurement record: <a href={`${repo.wiki}/features/steering/`}
          >steering on the wiki</a
        >.
      </p>
    </section>

    <!-- ============ cruise ============ -->
    <section id="cruise" aria-labelledby="h-cruise">
      <Section
        idx="02"
        id="h-cruise"
        title="radar cruise enhancements"
        intro="sunnypilot&rsquo;s cruise systems were rewritten for Mazda. One system manages your set speed — not several features fighting for control."
      />
      <Ledger
        items={[
          {
            dt: "Intelligent-Cruise-Button-Management (ICBM)",
            dd: "The core system. It lets zoompilot manage your cruise set speed safely.",
          },
          {
            dt: "Speed-Limit-Assist (SLA)",
            dd: "Adjusts your cruise speed automatically when you pass a speed sign. Uses nav SD or OpenStreetMap data, with optional +/- offsets.",
          },
          {
            dt: "Smart Cruise",
            dd: "Slows the car before a curve and speeds up again afterward, using vision or map data.",
          },
          {
            dt: "Deceleration Overshoot (Alpha)",
            dd: "Mazda's stock cruise (MRCC) reacts slowly before a turn. This drops the set speed earlier, so the car slows in time.",
          },
        ]}
      />
      <p class="wiki-more">
        Deep dives on the wiki:
        <a href={`${repo.wiki}/features/icbm/`}>ICBM</a>,
        <a href={`${repo.wiki}/features/speed-limit-assist/`}>SLA</a>,
        <a href={`${repo.wiki}/features/smart-cruise/`}>smart cruise</a>.
      </p>
    </section>

    <!-- ============ alerts ============ -->
    <section id="alerts" aria-labelledby="h-alerts">
      <Section idx="03" id="h-alerts" title="fix annoyances" />
      <Ledger
        items={[
          {
            dt: "Place hands on wheel alert",
            dd: "On 2022+ cars, logs show the LKAS_BLOCK alert does not actually stop steering. zoompilot turns that false alert off. Real faults still warn you.",
          },
          {
            dt: "Steering override hysteresis",
            dd: "A pothole can look like you tugging the wheel. zoompilot filters that out, with the same override filter Tesla and Rivian use.",
          },
        ]}
      />
    </section>

    <!-- ============ sensors ============ -->
    <section id="sensors" aria-labelledby="h-sensors">
      <Section
        idx="04"
        id="h-sensors"
        title="wire up sensors"
        intro="Your CX-5 ships with sensors the stock port ignores. zoompilot wires them in."
      />
      <Ledger
        items={[
          {
            dt: "Forward radar",
            dd: "Reads distance, angle, and closing speed for up to four cars ahead.",
          },
          {
            dt: "Blind-spot monitors",
            dd: "Feeds blind-spot data into openpilot for optional automatic lane-change safety checks.",
          },
          {
            dt: "Speed-limit signs",
            dd: "Reads speed signs via the LKAS camera (requires a nav SD card) to power Speed-Limit-Assist.",
          },
        ]}
      />
      <p class="wiki-more">
        Live readouts: <a href={`${repo.wiki}/features/sensor-readouts/`}
          >sensor readouts on the wiki</a
        >.
      </p>
    </section>

    <!-- ============ alpha longitudinal ============ -->
    <section id="alpha-long" class="alpha-sec" aria-labelledby="h-alpha-long">
      <Section
        idx="05"
        id="h-alpha-long"
        title="alpha longitudinal"
        intro="openpilot takes full control of the gas and brakes instead of Mazda&rsquo;s stock radar cruise."
      />
      <div class="alpha-warn">
        <p class="warn-label">warning · safety features disabled</p>
        <p>
          <strong
            >Alpha longitudinal turns the car&rsquo;s radar off.</strong
          >
          Automatic Emergency Braking (AEB) and forward collision alerts
          are DISABLED while it is on.
        </p>
      </div>
      <Ledger
        items={[
          {
            dt: "Experimental mode",
            dd: "The openpilot model drives the gas and brakes directly. It can brake for stop signs and lights. It often holds below the set speed.",
          },
          {
            dt: "Expect dash errors and safety issues",
            dd: "If your dash throws cruise, LKAS, or radar errors, turn the car completely off for 15 minutes to reset.",
          },
        ]}
      />
      <p class="credit">
        Credit:
        <a href="https://www.linkedin.com/in/alex-frutkin-6380459"
          >Alex Frutkin</a
        >
        (@yummydirt) did the heavy lifting on the reverse engineering and
        implementation for this feature.
      </p>
      <p class="wiki-more">
        Read <a href={`${repo.wiki}/features/alpha-longitudinal/`}>the alpha
        longitudinal page</a> and the <a href={`${repo.wiki}/safety/`}
          >safety page</a
        > before enabling.
      </p>
    </section>

    <!-- ============ coverage: cars synced from the wiki ============ -->
    <section id="coverage" aria-labelledby="h-coverage">
      <Section
        idx="06"
        id="h-coverage"
        title="additional Mazdas covered"
        intro="zoompilot runs on every supported Mazda platform — CX-5, CX-9, Mazda 3, and Mazda 6 — and steers to zero wherever a 2022-25 CX-5 electric power steering (EPS) motor is fitted, factory or swapped. The table is synced from the wiki's supported-cars page."
      />
      <CarTable cars={cars} />
      <CarChecker />
      <p class="wiki-more">
        EPS-swap detection and the upstream support tables:
        <a href={`${repo.wiki}/getting-started/supported-cars/`}
          >supported cars on the wiki</a
        >.
      </p>
    </section>

    <!-- ============ compare ============ -->
    <section id="compare" aria-labelledby="h-compare">
      <Section
        idx="07"
        id="h-compare"
        title="how it compares"
        intro="zoompilot is a fork of sunnypilot, which is a fork of openpilot. Here is what that stack adds to a 2022+ EPS Mazda."
      />
      <Compare />
    </section>

    <!-- ============ faq ============ -->
    <FAQ />

    <!-- ============ setup ============ -->
    <section id="setup" aria-labelledby="h-setup">
      <Section
        idx="09"
        id="h-setup"
        title="recommended setup"
        intro="You can manage almost everything directly on the device."
      />
      <SetupDemo />
      <ol class="steps">
        <li>
          <div>
            <strong>Factory-reset before installing.</strong>
            <span>Clear out stale settings from previous forks.</span>
          </div>
        </li>
        <li>
          <div>
            <strong>Pick a driving model.</strong>
            <span
              >Firehose is a good default. DTRv6 is a favorite, and CD210
              works well with alpha longitudinal.</span
            >
          </div>
        </li>
        <li>
          <div>
            <strong>Enable self-tune.</strong>
            <span
              >Ensure torque control, self-tune, and speed-dependent
              self-tune are on.</span
            >
          </div>
        </li>
        <li>
          <div>
            <strong>Leave custom tune off.</strong>
            <span>Keep custom tune and manual real-time off.</span>
          </div>
        </li>
      </ol>
      <p class="wiki-more">
        Every toggle, explained: <a href={`${repo.wiki}/settings/`}
          >settings on the wiki</a
        >.
      </p>
    </section>

    <!-- ============ install ============ -->
    <section id="install" aria-labelledby="h-install">
      <Section idx="10" id="h-install" title="install" />
      <InstallCard url={installUrl} />
      <p class="warn">
        <strong>This is experimental software.</strong>
        You drive the car, follow the law, and carry all the risk.
      </p>
      <p class="wiki-more">
        The full walkthrough, step by step:
        <a href={`${repo.wiki}/getting-started/install/`}>install on the
        wiki</a
        >.
      </p>
    </section>

    <!-- ============ first drive ============ -->
    <FirstDrive />

    <!-- ============ changelog ============ -->
    <Changelog />
  </main>

  <Footer />
</Base>

<script
  type="application/ld+json"
  set:html={JSON.stringify(appLd)}
  is:inline
/>
